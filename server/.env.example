HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=false
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006
# Если не задан, сервер использует in-memory хранилище для локальной разработки.
DATABASE_URL=postgresql://interview_atlas:interview_atlas@localhost:5432/interview_atlas
SOURCE_REFRESH_MS=900000
SOURCE_TIMEOUT_MS=25000
# Не короче 32 символов. Админские API отключены, пока токен не задан.
CMS_ADMIN_TOKEN=replace-with-a-long-random-token-at-least-32-chars
# Access-токен живёт 15 минут, refresh-сессия — 30 дней.
AUTH_ACCESS_TTL_MS=900000
AUTH_REFRESH_TTL_MS=2592000000
# Запуск пользовательского JavaScript только внутри Docker без сети и с лимитами.
CODE_RUNNER_ENABLED=false
CODE_RUNNER_IMAGE=node:24-alpine
